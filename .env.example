APP_ORIGIN=http://127.0.0.1:5173
API_PORT=3100
# Private durable directory; include this directory together with PostgreSQL in backups.
FILE_STORAGE_DIR=.runtime/private-files
DATABASE_URL=postgresql://construction_app:REPLACE_WITH_RANDOM_APP_PASSWORD@127.0.0.1:55432/construction
BETTER_AUTH_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
# Administration only. Never pass these values to the production API process.
DATABASE_ADMIN_URL=postgresql://construction_owner:REPLACE_WITH_RANDOM_ADMIN_PASSWORD@127.0.0.1:55432/construction
DB_APP_PASSWORD=REPLACE_WITH_RANDOM_APP_PASSWORD
