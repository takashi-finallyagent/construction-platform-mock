{
  "name": "construction-platform-mock",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:dev": "node --env-file=.env server/index.ts",
    "db:migrate": "node --env-file=.env server/manage.ts migrate",
    "account:provision": "node --env-file=.env server/manage.ts provision",
    "account:recover": "node --env-file=.env server/manage.ts recover-provision",
    "local:setup": "node scripts/local-setup.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:unit": "node --test tests/compliance.test.mjs tests/payment.test.mjs",
    "test:server": "node --env-file=.env --test tests/server.test.mjs",
    "test:provision": "node --env-file=.env --test tests/provision.test.mjs",
    "test:classification": "node --env-file=.env --test tests/classification.test.mjs tests/classification-migration.test.mjs",
    "test:classification:flow": "node --test tests/classification-flow.test.mjs",
    "test:workflow": "node --env-file=.env --test tests/workflow.test.mjs tests/workflow-migration.test.mjs",
    "test:photo-outbox": "node --test tests/photo-outbox.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "8.20.0",
    "better-auth": "1.7.12",
    "fastify": "5.12.7",
    "lucide-react": "^1.48.0",
    "pg": "8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
